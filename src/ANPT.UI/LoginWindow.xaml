<Window x:Class="ANPT.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ANPT Toolkit — Sign In"
        Height="480" Width="420"
        MinHeight="420" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BrushBackgroundPrimary}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="Segoe UI"
        WindowStyle="SingleBorderWindow">

    <Grid>
        <Border Background="{StaticResource BrushBackgroundPrimary}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320" Margin="24">

                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,28">
                    <Border Background="{StaticResource BrushAccentPrimary}"
                            CornerRadius="8" Padding="14,8" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="ANPT" FontWeight="Bold" FontSize="22" Foreground="White"/>
                    </Border>
                    <TextBlock Text="Automated Network Penetration Testing Toolkit"
                               FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Sign in to continue"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               TextAlignment="Center"
                               Margin="0,12,0,0"/>
                </StackPanel>

                <TextBlock Text="Username" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                <TextBox x:Name="UsernameBox"
                         Height="36"
                         Padding="10,8"
                         FontSize="13"
                         Background="{StaticResource BrushBackgroundSecondary}"
                         Foreground="{StaticResource BrushTextPrimary}"
                         BorderBrush="{StaticResource BrushBorder}"
                         BorderThickness="1"
                         CaretBrush="{StaticResource BrushTextPrimary}"
                         TabIndex="0"/>

                <TextBlock Text="Password" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,14,0,6"/>
                <PasswordBox x:Name="PasswordBox"
                             Height="36"
                             Padding="10,8"
                             FontSize="13"
                             Background="{StaticResource BrushBackgroundSecondary}"
                             Foreground="{StaticResource BrushTextPrimary}"
                             BorderBrush="{StaticResource BrushBorder}"
                             BorderThickness="1"
                             CaretBrush="{StaticResource BrushTextPrimary}"
                             TabIndex="1"
                             KeyDown="PasswordBox_KeyDown"/>

                <TextBlock x:Name="ErrorText"
                           Text=""
                           FontSize="12"
                           Foreground="{StaticResource BrushAccentDanger}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Visibility="Collapsed"/>

                <Button x:Name="LoginButton"
                        Content="Sign In"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="38"
                        Margin="0,20,0,0"
                        TabIndex="2"
                        Click="LoginButton_Click"
                        IsDefault="True"/>

                <TextBlock Text="Authorized use only. Obtain written permission before assessing any network."
                           FontSize="11"
                           Foreground="{StaticResource BrushTextMuted}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
