<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BackgroundPrimary">#0D1117</Color>
    <Color x:Key="BackgroundSecondary">#161B22</Color>
    <Color x:Key="BackgroundTertiary">#21262D</Color>
    <Color x:Key="BackgroundHover">#30363D</Color>

    <Color x:Key="AccentPrimary">#238636</Color>
    <Color x:Key="AccentSecondary">#1F6FEB</Color>
    <Color x:Key="AccentWarning">#D29922</Color>
    <Color x:Key="AccentDanger">#DA3633</Color>
    <Color x:Key="AccentCritical">#F85149</Color>

    <Color x:Key="TextPrimary">#E6EDF3</Color>
    <Color x:Key="TextSecondary">#8B949E</Color>
    <Color x:Key="TextMuted">#6E7681</Color>

    <Color x:Key="BorderColor">#30363D</Color>
    <Color x:Key="SidebarBackground">#010409</Color>

    <SolidColorBrush x:Key="BrushBackgroundPrimary" Color="{StaticResource BackgroundPrimary}"/>
    <SolidColorBrush x:Key="BrushBackgroundSecondary" Color="{StaticResource BackgroundSecondary}"/>
    <SolidColorBrush x:Key="BrushBackgroundTertiary" Color="{StaticResource BackgroundTertiary}"/>
    <SolidColorBrush x:Key="BrushBackgroundHover" Color="{StaticResource BackgroundHover}"/>
    <SolidColorBrush x:Key="BrushAccentPrimary" Color="{StaticResource AccentPrimary}"/>
    <SolidColorBrush x:Key="BrushAccentSecondary" Color="{StaticResource AccentSecondary}"/>
    <SolidColorBrush x:Key="BrushAccentWarning" Color="{StaticResource AccentWarning}"/>
    <SolidColorBrush x:Key="BrushAccentDanger" Color="{StaticResource AccentDanger}"/>
    <SolidColorBrush x:Key="BrushAccentCritical" Color="{StaticResource AccentCritical}"/>
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource TextMuted}"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BrushSidebar" Color="{StaticResource SidebarBackground}"/>

</ResourceDictionary>
