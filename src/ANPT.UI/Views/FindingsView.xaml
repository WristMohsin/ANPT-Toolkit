<UserControl x:Class="ANPT.UI.Views.FindingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Findings" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Text="Security observations generated by analysis rules against persisted Nmap results. Findings describe exposure and review items — not confirmed exploits."
                       Foreground="{StaticResource BrushTextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource InputTextBoxStyle}" VerticalAlignment="Center" Margin="0,0,12,0"
                     ToolTip="Search title, host, port, rule, or service" TextChanged="SearchBox_TextChanged"/>
            <ComboBox x:Name="SeverityFilterCombo" Grid.Column="1" Width="130" Margin="0,0,8,0" VerticalAlignment="Center"
                      SelectionChanged="Filter_SelectionChanged">
                <ComboBoxItem Content="All severities" IsSelected="True" Tag=""/>
                <ComboBoxItem Content="Info" Tag="Info"/>
                <ComboBoxItem Content="Low" Tag="Low"/>
                <ComboBoxItem Content="Medium" Tag="Medium"/>
                <ComboBoxItem Content="High" Tag="High"/>
                <ComboBoxItem Content="Critical" Tag="Critical"/>
            </ComboBox>
            <ComboBox x:Name="StatusFilterCombo" Grid.Column="2" Width="150" Margin="0,0,8,0" VerticalAlignment="Center"
                      SelectionChanged="Filter_SelectionChanged">
                <ComboBoxItem Content="All statuses" IsSelected="True" Tag=""/>
                <ComboBoxItem Content="Detected" Tag="Detected"/>
                <ComboBoxItem Content="Potential" Tag="Potential"/>
                <ComboBoxItem Content="Confirmed" Tag="Confirmed"/>
                <ComboBoxItem Content="Needs verification" Tag="NeedsVerification"/>
                <ComboBoxItem Content="False positive" Tag="FalsePositive"/>
                <ComboBoxItem Content="Remediated" Tag="Remediated"/>
            </ComboBox>
            <Button x:Name="RefreshButton" Grid.Column="3" Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0" Click="RefreshButton_Click"/>
            <Button x:Name="DetailsButton" Grid.Column="4" Content="Details" Style="{StaticResource PrimaryButtonStyle}"
                    IsEnabled="False" Click="DetailsButton_Click"/>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource BrushBackgroundSecondary}" BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <DataGrid x:Name="FindingsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent"
                          SelectionChanged="FindingsGrid_SelectionChanged"
                          MouseDoubleClick="FindingsGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Host" Binding="{Binding HostDisplay}" Width="130"/>
                        <DataGridTextColumn Header="Port" Binding="{Binding AffectedPort}" Width="90"/>
                        <DataGridTextColumn Header="Rule" Binding="{Binding RuleId}" Width="180"/>
                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=g}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyMessage" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" FontSize="13"
                           Text="No findings yet.&#x0a;&#x0a;Complete a scan, then use Analyze on the Scans view to run security analysis rules."/>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,8,0,0" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
    </Grid>
</UserControl>
