<UserControl x:Class="ANPT.UI.Views.FindingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Findings" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Security exposure observations from analysis rules against persisted Nmap results. Findings are review items — not confirmed exploits or CVEs."
                       Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource InputTextBoxStyle}"
                     Margin="0,0,8,0" TextChanged="Filter_Changed"
                     ToolTip="Search title, rule, host, port, evidence, recommendation"/>
            <ComboBox x:Name="SeverityFilterCombo" Grid.Column="1" Margin="0,0,8,0"
                      SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="All severity" Tag="" IsSelected="True"/>
                <ComboBoxItem Content="Info" Tag="Info"/>
                <ComboBoxItem Content="Low" Tag="Low"/>
                <ComboBoxItem Content="Medium" Tag="Medium"/>
                <ComboBoxItem Content="High" Tag="High"/>
                <ComboBoxItem Content="Critical" Tag="Critical"/>
            </ComboBox>
            <ComboBox x:Name="StatusFilterCombo" Grid.Column="2" Margin="0,0,8,0"
                      SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="All status" Tag="" IsSelected="True"/>
                <ComboBoxItem Content="Detected" Tag="Detected"/>
                <ComboBoxItem Content="Potential" Tag="Potential"/>
                <ComboBoxItem Content="Confirmed" Tag="Confirmed"/>
                <ComboBoxItem Content="Needs verification" Tag="NeedsVerification"/>
                <ComboBoxItem Content="False positive" Tag="FalsePositive"/>
                <ComboBoxItem Content="Remediated" Tag="Remediated"/>
            </ComboBox>
            <ComboBox x:Name="RuleFilterCombo" Grid.Column="3" Margin="0,0,8,0"
                      SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="All rules" Tag="" IsSelected="True"/>
                <ComboBoxItem Content="Open service" Tag="OPEN-SERVICE-EXPOSURE"/>
                <ComboBoxItem Content="Unidentified service" Tag="SERVICE-WITHOUT-IDENTIFICATION"/>
                <ComboBoxItem Content="Sensitive service" Tag="SENSITIVE-SERVICE-EXPOSURE"/>
            </ComboBox>
            <Button Grid.Column="4" Content="Clear" Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0" Click="ClearFilters_Click"/>
            <Button Grid.Column="5" Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"
                    Click="Refresh_Click"/>
        </Grid>

        <Grid Grid.Row="2">
            <DataGrid x:Name="FindingsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                      MouseDoubleClick="FindingsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/>
                    <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="90"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="Finding" Binding="{Binding Title}" Width="*" MinWidth="160"/>
                    <DataGridTextColumn Header="Rule" Binding="{Binding RuleId}" Width="160"/>
                    <DataGridTextColumn Header="Host" Binding="{Binding HostDisplay}" Width="120"/>
                    <DataGridTextColumn Header="Port" Binding="{Binding AffectedPort}" Width="80"/>
                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=g}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyMessage"
                       Text="No findings match the current filters.&#x0a;&#x0a;Run Analyze on a completed scan to generate exposure observations."
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Opacity="0.6" Visibility="Collapsed" TextWrapping="Wrap" Margin="40"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{StaticResource BrushTextSecondary}"/>
            <Button Grid.Column="1" x:Name="DetailsButton" Content="Details" Style="{StaticResource PrimaryButtonStyle}"
                    IsEnabled="False" Click="DetailsButton_Click"/>
        </Grid>
    </Grid>
</UserControl>
