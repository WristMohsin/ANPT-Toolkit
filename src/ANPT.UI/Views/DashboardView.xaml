<UserControl x:Class="ANPT.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Overview of assessment activity and security findings"
                       Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,20"/>

            <UniformGrid Columns="4" Margin="0,0,0,8">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="TotalTargetsValue" Text="..." Style="{StaticResource MetricValueStyle}"/>
                        <TextBlock Text="Total Targets" Style="{StaticResource MetricLabelStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="ActiveScansValue" Text="..." Style="{StaticResource MetricValueStyle}"/>
                        <TextBlock Text="Active Scans" Style="{StaticResource MetricLabelStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="OpenFindingsValue" Text="..." Style="{StaticResource MetricValueStyle}"/>
                        <TextBlock Text="Open Findings" Style="{StaticResource MetricLabelStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="TotalFindingsValue" Text="..." Style="{StaticResource MetricValueStyle}"/>
                        <TextBlock Text="Total Findings" Style="{StaticResource MetricLabelStyle}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="CriticalFindingsValue" Text="..." Style="{StaticResource MetricValueStyle}"
                                   Foreground="{StaticResource BrushAccentCritical}"/>
                        <TextBlock Text="Critical" Style="{StaticResource MetricLabelStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="HighFindingsValue" Text="..." Style="{StaticResource MetricValueStyle}"/>
                        <TextBlock Text="High" Style="{StaticResource MetricLabelStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="MediumFindingsValue" Text="..." Style="{StaticResource MetricValueStyle}"/>
                        <TextBlock Text="Medium" Style="{StaticResource MetricLabelStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="InfoFindingsValue" Text="..." Style="{StaticResource MetricValueStyle}"/>
                        <TextBlock Text="Info / Low" Style="{StaticResource MetricLabelStyle}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="Findings are exposure and review observations derived from completed scans. They are not confirmed vulnerabilities, CVEs, or exploit results."
                       Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
