<UserControl x:Class="ANPT.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Dashboard" Style="{StaticResource SectionHeaderStyle}"/>

            <TextBlock Text="Overview of the latest assessment activity"
                       Foreground="{StaticResource BrushTextSecondary}"
                       FontSize="13"
                       Margin="0,0,0,20"/>

            <UniformGrid Columns="4" Margin="0,0,0,8">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="TotalTargetsValue" Text="…" Style="{StaticResource MetricValueStyle}"/>
                        <TextBlock Text="Total Targets" Style="{StaticResource MetricLabelStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="ActiveScansValue" Text="…" Style="{StaticResource MetricValueStyle}"/>
                        <TextBlock Text="Active Scans" Style="{StaticResource MetricLabelStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="0" Style="{StaticResource MetricValueStyle}"/>
                        <TextBlock Text="Services Discovered" Style="{StaticResource MetricLabelStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="0" Style="{StaticResource MetricValueStyle}"/>
                        <TextBlock Text="Total Findings" Style="{StaticResource MetricLabelStyle}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource CardStyle}" BorderBrush="{StaticResource BrushAccentCritical}">
                    <StackPanel>
                        <TextBlock Text="0" Style="{StaticResource MetricValueStyle}" Foreground="{StaticResource BrushAccentCritical}"/>
                        <TextBlock Text="Critical" Style="{StaticResource MetricLabelStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" BorderBrush="{StaticResource BrushAccentDanger}">
                    <StackPanel>
                        <TextBlock Text="0" Style="{StaticResource MetricValueStyle}" Foreground="{StaticResource BrushAccentDanger}"/>
                        <TextBlock Text="High" Style="{StaticResource MetricLabelStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" BorderBrush="{StaticResource BrushAccentWarning}">
                    <StackPanel>
                        <TextBlock Text="0" Style="{StaticResource MetricValueStyle}" Foreground="{StaticResource BrushAccentWarning}"/>
                        <TextBlock Text="Medium" Style="{StaticResource MetricLabelStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="0" Style="{StaticResource MetricValueStyle}"/>
                        <TextBlock Text="Low / Info" Style="{StaticResource MetricLabelStyle}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource CardStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="Recent Scans" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                    <TextBlock Text="No scans have been executed yet. Create a target and start an authorized assessment to see activity here."
                               Foreground="{StaticResource BrushTextSecondary}"
                               TextWrapping="Wrap"
                               FontSize="13"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Authorization Notice" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"
                               Foreground="{StaticResource BrushAccentWarning}"/>
                    <TextBlock Text="This toolkit is intended for authorized penetration testing only. Always confirm written authorization and restrict scans to approved scope before execution."
                               Foreground="{StaticResource BrushTextSecondary}"
                               TextWrapping="Wrap"
                               FontSize="13"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
