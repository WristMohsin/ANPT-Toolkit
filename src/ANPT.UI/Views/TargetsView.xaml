<UserControl x:Class="ANPT.UI.Views.TargetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Targets" Style="{StaticResource SectionHeaderStyle}"/>
            <TextBlock Text="Manage assessment targets. Authorization must be confirmed before a target can be used for future scans."
                       Foreground="{StaticResource BrushTextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource InputTextBoxStyle}" VerticalAlignment="Center" Margin="0,0,12,0"
                     ToolTip="Search by name, address, type, or description" TextChanged="SearchBox_TextChanged"/>
            <ComboBox x:Name="StatusFilterCombo" Grid.Column="1" Width="140" Margin="0,0,8,0" VerticalAlignment="Center"
                      SelectionChanged="StatusFilterCombo_SelectionChanged">
                <ComboBoxItem Content="All statuses" IsSelected="True" Tag=""/>
                <ComboBoxItem Content="Active" Tag="Active"/>
                <ComboBoxItem Content="Disabled" Tag="Disabled"/>
                <ComboBoxItem Content="Archived" Tag="Archived"/>
            </ComboBox>
            <Button x:Name="RefreshButton" Grid.Column="2" Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0" Click="RefreshButton_Click"/>
            <Button x:Name="AddButton" Grid.Column="3" Content="+ New Target" Style="{StaticResource PrimaryButtonStyle}"
                    Click="AddButton_Click"/>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource BrushBackgroundSecondary}" BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <DataGrid x:Name="TargetsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0"
                          RowBackground="Transparent" AlternatingRowBackground="#0AFFFFFF"
                          HorizontalGridLinesBrush="{StaticResource BrushBorder}" FontSize="13"
                          MouseDoubleClick="TargetsGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.4*"/>
                        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="1.2*"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding TargetType}" Width="80"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                        <DataGridTemplateColumn Header="Authorization" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Not confirmed"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrushAccentWarning}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AuthorizationConfirmed}" Value="True">
                                                        <Setter Property="Text" Value="Confirmed"/>
                                                        <Setter Property="Foreground" Value="{StaticResource BrushAccentPrimary}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="130"/>
                        <DataGridTextColumn Header="Created By" Binding="{Binding CreatedBy}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyStateText"
                           Text="No targets yet.&#x0a;&#x0a;Create a target and confirm authorization before scheduling assessments."
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Foreground="{StaticResource BrushTextMuted}" FontSize="14" Visibility="Collapsed"
                           TextWrapping="Wrap" Margin="40"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
            <Button x:Name="EditButton" Content="Edit" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                    IsEnabled="False" Click="EditButton_Click"/>
            <Button x:Name="ArchiveButton" Content="Archive" Style="{StaticResource DangerButtonStyle}"
                    IsEnabled="False" Click="ArchiveButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
