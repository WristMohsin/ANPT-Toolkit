<UserControl x:Class="ANPT.UI.Views.ScansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Scan Management" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Create, start, and cancel authorized Nmap scans. Results parsing is not implemented in this phase."
                           Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0" Click="RefreshButton_Click"/>
                <Button x:Name="NewScanButton" Content="New Scan" Style="{StaticResource PrimaryButtonStyle}"
                        Click="NewScanButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Filters -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource InputTextBoxStyle}"
                     Margin="0,0,8,0" TextChanged="SearchBox_TextChanged"
                     ToolTip="Search by name, target, or profile"/>
            <ComboBox x:Name="StatusFilterCombo" Grid.Column="1" Margin="0,0,8,0"
                      SelectionChanged="StatusFilterCombo_SelectionChanged">
                <ComboBoxItem Content="All statuses" Tag="" IsSelected="True"/>
                <ComboBoxItem Content="Queued" Tag="Queued"/>
                <ComboBoxItem Content="Running" Tag="Running"/>
                <ComboBoxItem Content="Completed" Tag="Completed"/>
                <ComboBoxItem Content="Failed" Tag="Failed"/>
                <ComboBoxItem Content="Cancelled" Tag="Cancelled"/>
            </ComboBox>
            <Button x:Name="DetailsButton" Grid.Column="2" Content="Details" Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0" IsEnabled="False" Click="DetailsButton_Click"/>
            <Button x:Name="StartScanButton" Grid.Column="3" Content="Start" Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,8,0" IsEnabled="False" Click="StartScanButton_Click"/>
            <Button x:Name="CancelScanButton" Grid.Column="4" Content="Cancel" Style="{StaticResource DangerButtonStyle}"
                    IsEnabled="False" Click="CancelScanButton_Click"/>
        </Grid>

        <!-- Grid / empty -->
        <Grid Grid.Row="2">
            <DataGrid x:Name="ScansGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                      MouseDoubleClick="ScansGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="120"/>
                    <DataGridTextColumn Header="Target" Binding="{Binding Target.Name}" Width="140"/>
                    <DataGridTextColumn Header="Profile" Binding="{Binding ScanProfile.Name}" Width="140"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=g}" Width="140"/>
                    <DataGridTextColumn Header="Started" Binding="{Binding StartedAt, StringFormat=g}" Width="140"/>
                    <DataGridTextColumn Header="Completed" Binding="{Binding CompletedAt, StringFormat=g}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyStateText"
                       Text="No scans have been created yet.&#x0a;&#x0a;Create a scan against an authorized Active target, then Start it to run Nmap."
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Opacity="0.6" Visibility="Collapsed" TextWrapping="Wrap" Margin="40"/>
        </Grid>
    </Grid>
</UserControl>
