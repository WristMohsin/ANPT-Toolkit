<Window x:Class="ANPT.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ANPT Toolkit — Automated Network Penetration Testing Toolkit"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackgroundPrimary}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource BrushSidebar}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrushAccentPrimary}"
                            CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                        <TextBlock Text="ANPT" FontWeight="Bold" FontSize="12" Foreground="White"/>
                    </Border>
                    <TextBlock Text="Automated Network Penetration Testing Toolkit"
                               FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource BrushTextPrimary}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText"
                               Text="v1.0.0"
                               FontSize="12"
                               Foreground="{StaticResource BrushTextMuted}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>

                    <Border Background="{StaticResource BrushBackgroundTertiary}"
                            CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="UserDisplayText"
                                       Text="User"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text=" · "
                                       FontSize="12"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="RoleDisplayText"
                                       Text="Role"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushAccentSecondary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="LogoutButton"
                            Content="Logout"
                            Padding="12,4"
                            FontSize="12"
                            Cursor="Hand"
                            Background="Transparent"
                            Foreground="{StaticResource BrushTextSecondary}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            Click="LogoutButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource BrushSidebar}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0">
                        <Button x:Name="NavDashboard" Content="  Dashboard" Style="{StaticResource NavButtonActiveStyle}" Click="Nav_Click" Tag="Dashboard"/>
                        <Button x:Name="NavTargets" Content="  Targets" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="Targets"/>
                        <Button x:Name="NavScans" Content="  Scans" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="Scans"/>
                        <Button x:Name="NavHosts" Content="  Hosts" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="Hosts"/>
                        <Button x:Name="NavServices" Content="  Services" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="Services"/>
                        <Button x:Name="NavFindings" Content="  Findings" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="Findings"/>
                        <Button x:Name="NavReports" Content="  Reports" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="Reports"/>
                        <Button x:Name="NavProfiles" Content="  Scan Profiles" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="Profiles"/>
                        <Button x:Name="NavLogs" Content="  Activity Logs" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="Logs"/>
                        <Button x:Name="NavSettings" Content="  Settings" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="Settings"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,16" VerticalAlignment="Bottom">
                        <Button x:Name="NavAbout" Content="  About" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="About"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource BrushBackgroundPrimary}">
                <ContentControl x:Name="ContentArea" Margin="24"/>
            </Border>
        </Grid>
    </Grid>
</Window>
