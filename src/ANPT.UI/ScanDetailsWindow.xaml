<Window x:Class="ANPT.UI.ScanDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scan Details" Height="480" Width="560" MinHeight="400" MinWidth="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BrushBackgroundPrimary}"
        Foreground="{StaticResource BrushTextPrimary}" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Scan Details" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="NameText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="IdText" FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Status" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock x:Name="StatusText" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Text="Target" Foreground="{StaticResource BrushTextSecondary}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="TargetText" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="2" Text="Address" Foreground="{StaticResource BrushTextSecondary}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="AddressText" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="3" Text="Authorization" Foreground="{StaticResource BrushTextSecondary}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="AuthText" Grid.Row="3" Grid.Column="1" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="4" Text="Profile" Foreground="{StaticResource BrushTextSecondary}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="ProfileText" Grid.Row="4" Grid.Column="1" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="5" Text="Created" Foreground="{StaticResource BrushTextSecondary}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="CreatedText" Grid.Row="5" Grid.Column="1" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="6" Text="Started" Foreground="{StaticResource BrushTextSecondary}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="StartedText" Grid.Row="6" Grid.Column="1" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="7" Text="Completed" Foreground="{StaticResource BrushTextSecondary}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="CompletedText" Grid.Row="7" Grid.Column="1" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="8" Text="Duration" Foreground="{StaticResource BrushTextSecondary}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="DurationText" Grid.Row="8" Grid.Column="1" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="9" Text="Message" Foreground="{StaticResource BrushTextSecondary}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="MessageText" Grid.Row="9" Grid.Column="1" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Scan Results" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="No scan results are available yet. Scan execution (network discovery, port scanning, findings) will be implemented in a later phase."
                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="13" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Close" Style="{StaticResource SecondaryButtonStyle}"
                HorizontalAlignment="Right" Margin="0,16,0,0" IsCancel="True" Click="Close_Click"/>
    </Grid>
</Window>
