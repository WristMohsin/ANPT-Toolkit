<Window x:Class="ANPT.UI.ScanCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Scan" Height="420" Width="520" MinHeight="380" MinWidth="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BrushBackgroundPrimary}"
        Foreground="{StaticResource BrushTextPrimary}" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="New Scan" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Target *" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                <ComboBox x:Name="TargetCombo" Margin="0,0,0,4" Padding="8,6" FontSize="13"
                          DisplayMemberPath="Display"
                          Background="{StaticResource BrushBackgroundTertiary}"
                          Foreground="{StaticResource BrushTextPrimary}"
                          BorderBrush="{StaticResource BrushBorder}"
                          SelectionChanged="TargetCombo_SelectionChanged"/>
                <TextBlock x:Name="AuthHintText"
                           Text="Only Active targets with confirmed authorization are listed."
                           Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Text="Scan Profile *" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                <ComboBox x:Name="ProfileCombo" Margin="0,0,0,12" Padding="8,6" FontSize="13"
                          DisplayMemberPath="Display"
                          Background="{StaticResource BrushBackgroundTertiary}"
                          Foreground="{StaticResource BrushTextPrimary}"
                          BorderBrush="{StaticResource BrushBorder}"/>

                <TextBlock Text="Optional name" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,12"/>

                <TextBlock Text="Scans are created as Queued. Network scanning is not implemented in this phase."
                           Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="{StaticResource BrushAccentDanger}"
                   FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,8"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="CreateButton" Content="Create Scan" Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True" Click="Create_Click"/>
        </StackPanel>
    </Grid>
</Window>
