<Window x:Class="ANPT.UI.TargetEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Target" Height="520" Width="520" MinHeight="480" MinWidth="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BrushBackgroundPrimary}"
        Foreground="{StaticResource BrushTextPrimary}" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeaderText" Text="New Target" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Name *" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,12"/>
                <TextBlock Text="Address / Value *" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="AddressBox" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,4"
                         ToolTip="IP, CIDR, hostname, domain, or URL"/>
                <TextBlock Text="Examples: 192.168.1.10 · 10.0.0.0/24 · lab.example.com"
                           Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,12"/>
                <TextBlock Text="Type" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                <ComboBox x:Name="TypeCombo" Margin="0,0,0,12" Padding="8,6" FontSize="13"
                          Background="{StaticResource BrushBackgroundTertiary}"
                          Foreground="{StaticResource BrushTextPrimary}" BorderBrush="{StaticResource BrushBorder}">
                    <ComboBoxItem Content="Host" IsSelected="True"/>
                    <ComboBoxItem Content="Network"/>
                    <ComboBoxItem Content="Range"/>
                    <ComboBoxItem Content="Domain"/>
                    <ComboBoxItem Content="URL"/>
                </ComboBox>
                <TextBlock Text="Description" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="DescriptionBox" Style="{StaticResource InputTextBoxStyle}" Height="72"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>
                <TextBlock x:Name="StatusLabel" Text="Status" Foreground="{StaticResource BrushTextSecondary}"
                           FontSize="12" Margin="0,0,0,4" Visibility="Collapsed"/>
                <ComboBox x:Name="StatusCombo" Margin="0,0,0,12" Padding="8,6" FontSize="13" Visibility="Collapsed"
                          Background="{StaticResource BrushBackgroundTertiary}"
                          Foreground="{StaticResource BrushTextPrimary}" BorderBrush="{StaticResource BrushBorder}">
                    <ComboBoxItem Content="Active" Tag="Active" IsSelected="True"/>
                    <ComboBoxItem Content="Disabled" Tag="Disabled"/>
                    <ComboBoxItem Content="Archived" Tag="Archived"/>
                </ComboBox>
                <Border Background="{StaticResource BrushBackgroundSecondary}" BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                    <StackPanel>
                        <CheckBox x:Name="AuthCheckBox"
                                  Content="I confirm written authorization to assess this target"
                                  Foreground="{StaticResource BrushTextPrimary}" FontSize="13"/>
                        <TextBlock Text="Unauthorized targets can be stored but are not eligible for future scans. This records your confirmation only."
                                   Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap" Margin="24,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="{StaticResource BrushAccentDanger}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
